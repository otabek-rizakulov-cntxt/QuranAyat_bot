TOKEN=

# Redis connection URL (user state + media file-id cache).
#   Local (Docker):  redis://localhost:6379
#   Upstash (TLS):   rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
# Use the "Redis protocol" / ioredis URL from the Upstash console (starts with rediss://),
# NOT the REST URL. The rediss:// scheme enables TLS automatically.
REDIS_HOST_URL=redis://localhost:6379

# Postgres connection URL for durable per-user settings (ui_lang, translation_lang,
# reciter). Provisioned via Neon (e.g. through Vercel's marketplace integration).
# Use Neon's pooled connection string (the "-pooler" host, sslmode=require).
#   Local (Docker): postgresql://postgres:postgres@localhost:5432/quranayat
# Leave empty to run with an in-memory settings store (dev/tests only — settings
# are lost on restart).
DATABASE_URL=

AUDIO_BASE_URL=
PHOTO_BASE_URL=

# Public HTTPS base URL Telegram should POST updates to (e.g. your Cloudflare Tunnel
# or deployed host). The webhook registers as WEBHOOK_URL + "/webhook/" + TOKEN.
# It is also the URL Telegram fetches a stitched range recitation from
# (WEBHOOK_URL + "/media/range.mp3"), so inline queries for a range like 59:22-24
# only offer the combined audio when this is set.
WEBHOOK_URL=