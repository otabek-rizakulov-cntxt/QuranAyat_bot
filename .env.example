TOKEN=

# Redis connection URL (user state + media file-id cache).
#   Local (Docker):  redis://localhost:6379
#   Upstash (TLS):   rediss://default:<PASSWORD>@<ENDPOINT>.upstash.io:6379
# Use the "Redis protocol" / ioredis URL from the Upstash console (starts with rediss://),
# NOT the REST URL. The rediss:// scheme enables TLS automatically.
REDIS_HOST_URL=redis://localhost:6379

AUDIO_BASE_URL=
PHOTO_BASE_URL=
RECITATIONS_BASE_URL=

# Public HTTPS base URL Telegram should POST updates to (e.g. your Cloudflare Tunnel
# or deployed host). The webhook registers as WEBHOOK_URL + "/webhook/" + TOKEN.
WEBHOOK_URL=